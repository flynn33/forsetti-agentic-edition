  "implementationRules": {
    "objectOrientedDesign": [
      "Prefer protocols for public contracts and behavior boundaries.",
      "Use constructor dependency injection for collaborators.",
      "Production classes must be final unless subclassing is a deliberate documented public design point.",
      "Keep objects single-purpose and cohesive with tight access control.",
      "Prefer composition over inheritance across module boundaries.",
      "Avoid global mutable state, implicit singleton coupling, and service-locator shortcuts when a narrower interface is practical."
    ],
    "consumerIntegration": [
      "Treat Forsetti as a sealed runtime dependency and use public package products only.",
      "Do not modify, copy, fork, or patch Forsetti internals for application-specific behavior.",
      "Implement extension needs through public modules, services, runtime composition, and public bootstrap APIs.",
      "Request an upstream framework enhancement when the required public extension point does not exist."
    ],
    "moduleBoundaries": [
      "Each module or target owns one clear responsibility and modules do not directly depend on other module implementations.",
      "In a multi-module single application, exactly one dedicated UI module owns application UI while service modules remain separate.",
      "A single-module application uses one ForsettiAppModule that owns its UI and runs with Forsetti behind the application surface.",
      "SwiftUI, Metal, and other Apple-native frameworks are valid in the correct app-owned module or architectural layer.",
      "Keep dependency direction one-way and prohibit direct or indirect cycles."
    ],
    "runtimeSafety": [
      "Manifest capabilities and runtime requirements are enforced rather than advisory.",
      "Module identity, manifest identity, registration records, and manifest hashes must agree before activation.",
      "Production rendering must wait for runtime boot, compatibility, entitlement, and app-module activation.",
      "Persisted activation restoration must pass through normal registration, compatibility, entitlement, capability, and runtime-requirement gates.",
      "Treat manifest changes as architecture changes and keep manifest, descriptor, entry point, and registry identity aligned."
    ],
    "errorAndConcurrency": [
      "Do not swallow errors silently.",
      "Do not degrade Sendable or concurrency correctness.",
      "Do not introduce force unwraps without a documented invariant and no practical alternative."
    ]
  },
