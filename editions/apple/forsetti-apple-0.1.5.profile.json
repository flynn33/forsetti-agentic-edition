  "runtimeInvariants": {
    "registrationAndIdentity": [
      "Manifest discovery creates a registration record before activation.",
      "Activation requires a registration record matching the current manifest hash and manifest identity.",
      "Resolved descriptor and implementation identity must match moduleID, moduleType, moduleVersion, entryPoint, schema/template, capabilities, default role, and runtime requirements."
    ],
    "activation": [
      "UI and app module activation requires ForsettiUIModule or ForsettiAppModule compatibility before lifecycle start.",
      "Only one UI or app module may be active at a time; activating another deactivates the previously active UI or app module.",
      "Service modules may remain concurrently active.",
      "Runtime boot refreshes entitlements before restoring persisted activation state.",
      "Runtime shutdown deactivates loaded modules without clearing persisted activation state.",
      "Restored modules pass through the normal registration, compatibility, entitlement, capability, and runtime requirement gates."
    ],
    "runtimeRequirements": [
      "Each I/O kind requires its mapped capability.",
      "A required I/O provider must be available before activation.",
      "framework_mediated_shared data isolation requires an available shared_database provider.",
      "A default module role must be valid for the module type and must declare its mapped capability when one is required.",
      "A service module cannot conform to ForsettiUIModule or provide UI contributions."
    ],
    "serviceAccess": [
      "Service resolution is capability-scoped to the requesting module.",
      "Unknown service protocol types are denied.",
      "Mapped service protocol types are denied unless the module was granted the mapped capability."
    ],
    "moduleContext": [
      "A module receives a scoped context bound to its manifest moduleID.",
      "Event publishing, messaging, and logging use the bound source module identity rather than caller-supplied identity."
    ],
    "manifestLoading": [
      "Strict manifest-directory loading fails fast on invalid manifest JSON or validation errors.",
      "Recursive fallback discovery ignores unrelated JSON that is not manifest-shaped.",
      "Duplicate moduleID values fail discovery."
    ],
    "uiContributions": [
      "Toolbar item contributions require toolbar_items.",
      "View injection contributions require view_injection.",
      "Overlay schema, routes, and pointers require routing_overlay.",
      "Theme mask contributions require ui_theme_mask.",
      "Actual contribution identifiers must be declared in runtimeRequirements.ui.",
      "Publishing an event from a toolbar action does not require a separate event_publishing capability in the Apple contract."
    ]
  },
